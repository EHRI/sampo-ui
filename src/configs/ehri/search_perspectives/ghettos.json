{
  "id": "ghettos",
  "endpoint": {
    "url": "https://lod.ehri-project-test.eu/sparql",
    "useAuth": false,
    "prefixesFile": "SparqlQueriesPrefixes.js"
  },
  "sparqlQueriesFile": "SparqlQueriesGhettos.js",
  "baseURI": "http://lod.ehri-project-test.eu",
  "URITemplate": "<BASE_URI>/vocabularies/ehri-ghettos/<LOCAL_ID>",
  "facetClass": "<http://lod.ehri-project-test.eu/vocabularies/ehri-ghettos>",
  "facetClassPredicate": "skos:inScheme",
  "frontPageImage": "main_page/judenstern.jpg",
  "searchMode": "faceted-search",
  "enableDynamicLanguageChange": false,
  "defaultActiveFacets": [
    "prefLabel"
  ],
  "defaultTab": "table",
  "defaultInstancePageTab": "table",
  "resultClasses": {
    "ghettos": {
      "paginatedResultsConfig": {
        "tabID": 0,
        "component": "ResultTable",
        "tabPath": "table",
        "tabIcon": "CalendarViewDay",
        "propertiesQueryBlock": "ghettosProperties",
        "pagesize": 50,
        "sortByPredicate": "skos:prefLabel",
        "sortDirection": "asc"
      },
      "instanceConfig": {
        "propertiesQueryBlock": "ghettosPlusLinkedDescriptionsProperties",
        "instancePageResultClasses": {
          "instancePageTable": {
            "tabID": 0,
            "component": "InstancePageTable",
            "tabPath": "table",
            "tabIcon": "CalendarViewDay"
          },
          "instancePageExport": {
            "tabID": 1,
            "component": "Export",
            "tabPath": "export",
            "tabIcon": "CloudDownload",
            "pageType": "instancePage"
          }
        }
      }
    },
    "ghettosMap": {
      "tabID": 2,
      "component": "LeafletMap",
      "tabPath": "ghettos_map",
      "tabIcon": "AddLocation",
      "sparqlQuery": "ghettosLocationsQuery",
      "facetClass": "ghettos",
      "filterTarget": "ghetto",
      "resultMapper": "mapPlaces",
      "showExternalLayers": true,
      "instanceConfig": {
          "propertiesQueryBlock": "ghettosPropertiesInfoWindow",
          "createPopUpContent": "createPopUpContentMMM"
      }
    },
    "export": {
      "tabID": 3,
      "component": "Export",
      "tabPath": "export",
      "tabIcon": "CloudDownload",
      "resultClass": "ghettos",
      "facetClass": "ghettos"
    }
  },
  "maps": {
    "ghettosMap": {
        "center": [
            22.43,
            10.37
        ],
        "zoom": 2
    }
  },
  "properties": [
    {
      "id": "uri",
      "valueType": "object",
      "makeLink": true,
      "externalLink": true,
      "sortValues": true,
      "numberedList": false,
      "onlyOnInstancePage": true
    },
    {
      "id": "portalURI",
      "valueType": "object",
      "makeLink": true,
      "externalLink": true,
      "sortValues": true,
      "numberedList": false,
      "onlyOnInstancePage": true
    },
    {
      "id": "wikidataURI",
      "valueType": "object",
      "makeLink": true,
      "externalLink": true,
      "sortValues": true,
      "numberedList": false,
      "onlyOnInstancePage": true
    },
    {
      "id": "prefLabel",
      "valueType": "object",
      "makeLink": true,
      "externalLink": false,
      "sortValues": true,
      "numberedList": false
    },
    {
      "id": "otherLabels",
      "valueType": "string",
      "makeLink": false,
      "externalLink": false,
      "sortValues": false,
      "numberedList": false,
      "collapsedMaxWords": 20,
      "expandedOnInstancePage": true,
      "disableSort": true
    },
    {
      "id": "numberOfConnectedDescriptions",
      "valueType": "string",
      "makeLink": false,
      "externalLink": false,
      "sortValues": true,
      "numberedList": false,
      "disableSort": true
    },
    {
      "id": "archivalDescriptionsLink",
      "valueType": "object",
      "makeLink": true,
      "externalLink": false,
      "sortValues": true,
      "numberedList": false,
      "disableSort": true,
      "onlyOnInstancePage": true,
      "expandedOnInstancePage": true,
      "linkAsButton": true
    }
  ],
  "facets": {
    "prefLabel": {
      "sortByPredicate": "skos:prefLabel",
      "searchField": true,
      "containerClass": "one",
      "facetType": "text",
      "filterType": "textFilter",
      "textQueryProperty": "skos:prefLabel"
    }
  }
}