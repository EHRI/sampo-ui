{
  "id": "countries",
  "endpoint": {
    "url": "https://lod.ehri-project-test.eu/sparql",
    "useAuth": false,
    "prefixesFile": "SparqlQueriesPrefixes.js"
  },
  "sparqlQueriesFile": "SparqlQueriesCountries.js",
  "baseURI": "http://lod.ehri-project-test.eu",
  "URITemplate": "<BASE_URI>/countries/<LOCAL_ID>",
  "facetClass": "ehri:Country",
  "frontPageImage": "main_page/places-452x262.jpg",
  "searchMode": "faceted-search",
  "enableDynamicLanguageChange": false,
  "defaultActiveFacets": [
      "prefLabel"
  ],
  "defaultTab": "table",
  "defaultInstancePageTab": "table",
  "resultClasses": {
    "countries": {
      "paginatedResultsConfig": {
        "tabID": 0,
        "component": "ResultTable",
        "tabPath": "table",
        "tabIcon": "CalendarViewDay",
        "propertiesQueryBlock": "countryProperties",
        "pagesize": 50,
        "sortByPredicate": "rico:name",
        "sortDirection": "asc"
      },
      "instanceConfig": {
        "propertiesQueryBlock": "countryProperties",
        "instancePageResultClasses": {
          "instancePageTable": {
            "tabID": 0,
            "component": "InstancePageTable",
            "tabPath": "table",
            "tabIcon": "CalendarViewDay"
          }
        }
      }
    }
  },
  "properties": [
    {
      "id": "uri",
      "valueType": "object",
      "makeLink": true,
      "externalLink": true,
      "sortValues": true,
      "numberedList": false,
      "onlyOnInstancePage": true
    },
    {
      "id": "portalURI",
      "valueType": "object",
      "makeLink": true,
      "externalLink": true,
      "sortValues": true,
      "numberedList": false,
      "onlyOnInstancePage": true
    },
    {
      "id": "prefLabel",
      "valueType": "object",
      "makeLink": true,
      "externalLink": false,
      "sortValues": true,
      "numberedList": false
    },
    {
      "id": "flag",
      "valueType": "image",
      "previewImageHeight": 100,
      "previewImageWidth": 150,
      "makeLink": true,
      "externalLink": false,
      "sortValues": false,
      "numberedList": false
    },
    {
      "id": "numberOfInstitutions",
      "valueType": "string",
      "makeLink": false,
      "externalLink": false,
      "sortValues": false,
      "numberedList": false
    },
    {
      "id": "numberOfDescriptions",
      "valueType": "string",
      "makeLink": false,
      "externalLink": false,
      "sortValues": false,
      "numberedList": false
    },
    {
      "id": "archivalHistory",
      "valueType": "string",
      "makeLink": false,
      "externalLink": false,
      "sortValues": false,
      "numberedList": false,
      "collapsedMaxWords": 20,
      "expandedOnInstancePage": true
    },
    {
      "id": "archivalSituation",
      "valueType": "string",
      "makeLink": false,
      "externalLink": false,
      "sortValues": false,
      "numberedList": false,
      "collapsedMaxWords": 20,
      "expandedOnInstancePage": true
    },
    {
      "id": "researchExtensive",
      "valueType": "string",
      "makeLink": false,
      "externalLink": false,
      "sortValues": false,
      "numberedList": false,
      "collapsedMaxWords": 20,
      "expandedOnInstancePage": true
    },
    {
      "id": "researchSummary",
      "valueType": "string",
      "makeLink": false,
      "externalLink": false,
      "sortValues": true,
      "numberedList": false,
      "collapsedMaxWords": 20,
      "expandedOnInstancePage": true
    }
  ],
  "facets": {
    "prefLabel": {
        "sortByPredicate": "rico:name",
        "searchField": true,
        "containerClass": "one",
        "facetType": "text",
        "filterType": "textFilter",
        "textQueryProperty": "rico:name"
    }
  }
}