{
  "id": "camps",
  "endpoint": {
    "url": "https://lod.ehri-project-test.eu/sparql",
    "useAuth": false,
    "prefixesFile": "SparqlQueriesPrefixes.js"
  },
  "sparqlQueriesFile": "SparqlQueriesCamps.js",
  "baseURI": "http://lod.ehri-project-test.eu",
  "URITemplate": "<BASE_URI>/vocabularies/ehri-camps/<LOCAL_ID>",
