  "facetClassPredicate": "skos:inScheme",
  "frontPageImage": "main_page/auschwitz-camp.jpg",
  "searchMode": "faceted-search",
  "enableDynamicLanguageChange": false,
  "defaultActiveFacets": [
    "prefLabel"
  ],
  "defaultTab": "table",
  "defaultInstancePageTab": "table",
  "resultClasses": {
    "camps": {
      "paginatedResultsConfig": {
        "tabID": 0,
        "component": "ResultTable",
        "tabPath": "table",
        "tabIcon": "CalendarViewDay",
        "propertiesQueryBlock": "campsProperties",
        "pagesize": 50,
        "sortByPredicate": "skos:prefLabel",
        "sortDirection": "asc"
      },
      "instanceConfig": {
        "propertiesQueryBlock": "campsProperties",
        "instancePageResultClasses": {
          "instancePageTable": {
            "tabID": 0,
            "component": "InstancePageTable",
            "tabPath": "table",
            "tabIcon": "CalendarViewDay"
          }
        }
      }
    },
    "campsMap": {
      "tabID": 2,
      "component": "LeafletMap",
      "tabPath": "camps_map",
      "tabIcon": "AddLocation",
      "sparqlQuery": "campsLocationsQuery",
      "facetClass": "camps",
      "filterTarget": "camp",
      "resultMapper": "mapPlaces",
      "showExternalLayers": true,
      "instanceConfig": {
          "propertiesQueryBlock": "campsPropertiesInfoWindow",
          "createPopUpContent": "createPopUpContentMMM"
      }
    }
  },
  "maps": {
    "campsMap": {
        "center": [
            22.43,
            10.37
        ],
        "zoom": 2
    }
  },
  "properties": [
    {
      "id": "uri",
      "valueType": "object",
      "makeLink": true,
      "externalLink": true,
      "sortValues": true,
      "numberedList": false,
      "onlyOnInstancePage": true
    },
    {
      "id": "portalURI",
      "valueType": "object",
      "makeLink": true,
      "externalLink": true,
      "sortValues": true,
      "numberedList": false,
      "onlyOnInstancePage": true
    },
    {
      "id": "wikidataURI",
      "valueType": "object",
      "makeLink": true,
      "externalLink": true,
      "sortValues": true,
      "numberedList": false,
      "onlyOnInstancePage": true
    },
    {
      "id": "prefLabel",
      "valueType": "object",
      "makeLink": true,
      "externalLink": false,
      "sortValues": true,
      "numberedList": false
    },
    {
      "id": "altLabels",
      "valueType": "string",
      "makeLink": false,
      "externalLink": false,
      "sortValues": false,
      "numberedList": false,
      "collapsedMaxWords": 20,
      "expandedOnInstancePage": true
    },
    {
      "id": "numberOfConnectedDescriptions",
      "valueType": "string",
      "makeLink": false,
      "externalLink": false,
      "sortValues": true,
      "numberedList": false
    }
