  "facets": {
    "prefLabel": {
      "sortByPredicate": "rico:name",
      "searchField": true,
      "containerClass": "one",
      "facetType": "text",
      "filterType": "textFilter",
      "textQueryProperty": "rico:name"
    },
    "country": {
      "containerClass": "ten",
      "facetType": "list",
      "facetValueFilter": "?id a ?place . VALUES ?place { ehri:Country }",
      "facetLabelPredicate": "rico:name",
      "filterType": "uriFilter",
      "predicate": "^rico:isOrWasLocationOfAgent",
      "searchField": true,
      "sortButton": true,
      "sortBy": "instanceCount",
      "sortByPredicate": "^rico:isOrWasLocationOfAgent/rico:name",
      "sortDirection": "desc",
      "pieChartButton": true
    },
    "region": {
      "containerClass": "ten",
      "facetType": "list",
      "facetValueFilter": "?id a ?place . VALUES ?place { ehri:Region }",
      "facetLabelPredicate": "rico:name",
      "filterType": "uriFilter",
      "predicate": "rico:agentHasOrHadLocation/rico:isContainedByTransitive*",
      "searchField": true,
      "sortButton": true,
      "sortBy": "instanceCount",
      "sortByPredicate": "rico:agentHasOrHadLocation/rico:isContainedByTransitive*/rico:name",
      "sortDirection": "desc",
      "pieChartButton": true
    },
    "city": {
      "containerClass": "ten",
      "facetType": "list",
      "facetValueFilter": "?id a ?place . VALUES ?place { ehri:City }",
      "facetLabelPredicate": "rico:name",
      "filterType": "uriFilter",
      "predicate": "rico:agentHasOrHadLocation/rico:isContainedByTransitive*",
      "searchField": true,
      "sortButton": true,
