{
  "id": "terms",
  "endpoint": {
    "url": "https://lod.ehri-project-test.eu/sparql",
    "useAuth": false,
    "prefixesFile": "SparqlQueriesPrefixes.js"
  },
  "sparqlQueriesFile": "SparqlQueriesTerms.js",
  "baseURI": "http://lod.ehri-project-test.eu",
  "URITemplate": "<BASE_URI>/vocabularies/ehri-terms/<LOCAL_ID>",
  "facetClass": "<http://lod.ehri-project-test.eu/vocabularies/ehri-terms>",
  "facetClassPredicate": "skos:inScheme",
  "frontPageImage": "main_page/works-452x262.jpg",
  "searchMode": "faceted-search",
  "enableDynamicLanguageChange": false,
  "defaultActiveFacets": [
    "prefLabel"
  ],
  "defaultTab": "table",
  "defaultInstancePageTab": "table",
  "resultClasses": {
    "terms": {
      "paginatedResultsConfig": {
        "tabID": 0,
        "component": "ResultTable",
        "tabPath": "table",
        "tabIcon": "CalendarViewDay",
        "propertiesQueryBlock": "termsProperties",
        "pagesize": 50,
        "sortByPredicate": "skos:prefLabel",
        "sortDirection": "asc"
      },
      "instanceConfig": {
        "propertiesQueryBlock": "termsPlusLinkedDescriptionsProperties",
        "instancePageResultClasses": {
          "instancePageTable": {
            "tabID": 0,
            "component": "InstancePageTable",
            "tabPath": "table",
            "tabIcon": "CalendarViewDay"
          },
          "termsNetworkNarrower": {
            "tabID": 1,
            "component": "Network",
            "tabPath": "network_terms_narrower",
            "tabIcon": "BubbleChart",
            "pageType": "instancePage",
            "sparqlQuery": "termNetworkNarrowerLinksQuery",
            "sparqlQueryNodes": "termNetworkNodeQuery",
            "useNetworkAPI": true,
            "limit": 20,
            "optimize": 1.2,
            "preprocess": "preprocessPageRank",
            "style": [
              {
                "selector": "node",
                "style": {
                  "shape": "ellipse",
                  "label": "data(prefLabel)",
                  "font-size": "8"
                }
              },
              {
                "selector": "edge",
                "style": {
                  "curve-style": "bezier",
                  "target-arrow-shape": "triangle",
                  "target-arrow-color": "#999",
                  "color": "#555",
                  "font-size": "10",
                  "text-valign": "top",
                  "text-halign": "center",
                  "edge-text-rotation": "autorotate",
                  "text-background-opacity": 1,
                  "text-background-color": "white",
                  "text-background-shape": "roundrectangle",
                  "label": "data(typeOfRelation)"
                }
              }
            ],
            "layout": {
              "name": "cose",
              "idealEdgeLength": 100,
              "nodeOverlap": 20,
              "refresh": 20,
              "fit": true,
              "padding": 30,
              "randomize": false,
              "componentSpacing": 100,
              "nodeRepulsion": 400000,
              "edgeElasticity": 100,
              "nestingFactor": 5,
              "gravity": 80,
              "numIter": 1347,
              "initialTemp": 200,
              "coolingFactor": 0.95,
              "minTemp": 1
            }
          },
          "termsNetworkBroader": {
            "tabID": 2,
            "component": "Network",
            "tabPath": "network_terms_broader",
            "tabIcon": "BubbleChart",
            "pageType": "instancePage",
            "sparqlQuery": "termNetworkBroaderLinksQuery",
            "sparqlQueryNodes": "termNetworkNodeQuery",
            "useNetworkAPI": true,
            "limit": 20,
            "optimize": 1.2,
            "preprocess": "preprocessPageRank",
            "style": [
              {
                "selector": "node",
                "style": {
                  "shape": "ellipse",
                  "label": "data(prefLabel)",
                  "font-size": "8"
                }
              },
              {
                "selector": "edge",
                "style": {
                  "curve-style": "bezier",
                  "target-arrow-shape": "triangle",
                  "target-arrow-color": "#999",
                  "color": "#555",
                  "font-size": "10",
                  "text-valign": "top",
                  "text-halign": "center",
                  "edge-text-rotation": "autorotate",
                  "text-background-opacity": 1,
                  "text-background-color": "white",
                  "text-background-shape": "roundrectangle",
                  "label": "data(typeOfRelation)"
                }
              }
            ],
            "layout": {
              "name": "cose",
              "idealEdgeLength": 100,
              "nodeOverlap": 20,
              "refresh": 20,
              "fit": true,
              "padding": 30,
              "randomize": false,
              "componentSpacing": 100,
              "nodeRepulsion": 400000,
              "edgeElasticity": 100,
              "nestingFactor": 5,
              "gravity": 80,
              "numIter": 1347,
              "initialTemp": 200,
              "coolingFactor": 0.95,
              "minTemp": 1
            }
          }
        }
      }
    }
  },
  "properties": [
    {
      "id": "uri",
      "valueType": "object",
      "makeLink": true,
      "externalLink": true,
      "sortValues": true,
      "numberedList": false,
      "onlyOnInstancePage": true
    },
    {
      "id": "portalURI",
      "valueType": "object",
      "makeLink": true,
      "externalLink": true,
      "sortValues": true,
      "numberedList": false,
      "onlyOnInstancePage": true
    },
    {
      "id": "prefLabel",
      "valueType": "object",
      "makeLink": true,
      "externalLink": false,
      "sortValues": true,
      "numberedList": false
    },
    {
      "id": "otherLabels",
      "valueType": "string",
      "makeLink": false,
      "externalLink": false,
      "sortValues": false,
      "numberedList": false,
      "collapsedMaxWords": 20,
      "expandedOnInstancePage": true,
      "disableSort": true
    },
    {
      "id": "broader",
      "valueType": "object",
      "makeLink": true,
      "externalLink": false,
      "sortValues": true,
      "numberedList": false,
      "expandedOnInstancePage": true,
      "disableSort": true
    },
    {
      "id": "narrower",
      "valueType": "object",
      "makeLink": true,
      "externalLink": false,
      "sortValues": true,
      "numberedList": false,
      "expandedOnInstancePage": true,
      "disableSort": true
    },
    {
      "id": "numberOfConnectedDescriptions",
      "valueType": "string",
      "makeLink": false,
      "externalLink": false,
      "sortValues": true,
      "numberedList": false,
      "disableSort": true
    },
    {
      "id": "archivalDescriptionsLink",
      "valueType": "object",
      "makeLink": true,
      "externalLink": false,
      "sortValues": true,
      "numberedList": false,
      "disableSort": true,
      "onlyOnInstancePage": true,
      "expandedOnInstancePage": true,
      "linkAsButton": true
    }
  ],
  "facets": {
    "prefLabel": {
      "sortByPredicate": "skos:prefLabel",
      "searchField": true,
      "containerClass": "one",
      "facetType": "text",
      "filterType": "textFilter",
      "textQueryProperty": "skos:prefLabel"
    }
  }
}