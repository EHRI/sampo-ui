{
    "id": "archivalDescriptions",
    "endpoint": {
        "url": "https://lod.ehri-project-test.eu/sparql",
        "useAuth": false,
        "prefixesFile": "SparqlQueriesPrefixes.js"
    },
    "sparqlQueriesFile": "SparqlQueriesArchivalDescriptions.js",
    "baseURI": "http://lod.ehri-project-test.eu",
    "URITemplate": "<BASE_URI>/units/<LOCAL_ID>",
    "facetClass": "ehri:RecordSet",
    "frontPageImage": "main_page/theme-image-3.jpg",
    "searchMode": "faceted-search",
    "enableDynamicLanguageChange": false,
    "defaultActiveFacets": [
        "prefLabel"
    ],
    "defaultTab": "table",
    "defaultInstancePageTab": "table",
    "resultClasses": {
        "archivalDescriptions": {
            "paginatedResultsConfig": {
                "tabID": 0,
                "component": "ResultTable",
                "tabPath": "table",
                "tabIcon": "CalendarViewDay",
                "propertiesQueryBlock": "archivalDescriptionProperties",
                "pagesize": 50,
                "sortByPredicate": "rico:title",
                "sortDirection": "desc"
            },
            "instanceConfig": {
                "propertiesQueryBlock": "archivalDescriptionProperties",
                "instancePageResultClasses": {
                    "instancePageTable": {
                        "tabID": 0,
                        "component": "InstancePageTable",
                        "tabPath": "table",
                        "tabIcon": "CalendarViewDay"
                    },
                    "descriptionsCopyNetwork": {
                        "tabID": 1,
                        "component": "Network",
                        "tabPath": "network_copy_links_archival_descriptions",
                        "tabIcon": "BubbleChart",
                        "pageType": "instancePage",
                        "sparqlQuery": "descriptionCopyLinksNetworkQuery",
                        "sparqlQueryNodes": "descriptionCopyLinksNetworkNodeQuery",
                        "useNetworkAPI": true,
                        "limit": 25,
                        "optimize": 1.2,
                        "preprocess": "preprocessPageRank",
                        "style": [
                            {
                                "selector": "node",
                                "style": {
                                    "shape": "ellipse",
                                    "label": "data(prefLabel)",
                                    "font-size": "8"
                                }
                            },
                            {
                                "selector": "edge",
                                "style": {
                                    "curve-style": "bezier",
                                    "target-arrow-shape": "triangle",
                                    "target-arrow-color": "#999",
                                    "color": "#555",
                                    "font-size": "10",
                                    "text-valign": "top",
                                    "text-halign": "center",
                                    "edge-text-rotation": "autorotate",
                                    "text-background-opacity": 1,
                                    "text-background-color": "white",
                                    "text-background-shape": "roundrectangle",
                                    "label": "data(typeOfRelation)"
                                }
                            }
                        ],
                        "layout": {
                            "name": "cose",
                            "idealEdgeLength": 100,
                            "nodeOverlap": 20,
                            "refresh": 20,
                            "fit": true,
                            "padding": 30,
                            "randomize": false,
                            "componentSpacing": 100,
                            "nodeRepulsion": 400000,
                            "edgeElasticity": 100,
                            "nestingFactor": 5,
                            "gravity": 80,
                            "numIter": 1347,
                            "initialTemp": 200,
                            "coolingFactor": 0.95,
                            "minTemp": 1
                        }
                    }
                }
            }
        },
        "knowledgeGraphMetadata": {
            "sparqlQuery": "knowledgeGraphMetadataQuery",
            "resultMapper": "makeObjectList"
        },
        "archivalDescriptionsCharts": {
            "tabID": 1,
            "component": "ApexCharts",
            "doNotRenderOnMount": true,
            "tabPath": "pie_chart",
            "tabIcon": "PieChart",
            "facetClass": "archivalDescriptions",
            "dropdownForResultClasses": true,
            "defaultResultClass": "archivalDescriptionsByCountry",
            "resultClasses": {
                "archivalDescriptionsByCountry": {
                    "sparqlQuery": "archivalDescriptionsPerCountryQuery",
                    "filterTarget": "archivalDescription",
                    "resultMapper": "mapPieChart",
                    "sliceVisibilityThreshold": 0.01,
                    "dropdownForChartTypes": true,
                    "chartTypes": [
                        {
                            "id": "pie",
                            "createChartData": "createApexPieChartData"
                        },
                        {
                            "id": "bar",
                            "createChartData": "createApexBarChartData"
                        }
                    ]
                },
                "archivalDescriptionsByRegion": {
                    "sparqlQuery": "archivalDescriptionsPerRegionQuery",
                    "filterTarget": "archivalDescription",
                    "resultMapper": "mapPieChart",
                    "sliceVisibilityThreshold": 0.01,
                    "dropdownForChartTypes": true,
                    "chartTypes": [
                        {
                            "id": "pie",
                            "createChartData": "createApexPieChartData"
                        },
                        {
                            "id": "bar",
                            "createChartData": "createApexBarChartData"
                        }
                    ]
                },
                "archivalDescriptionsByCity": {
                    "sparqlQuery": "archivalDescriptionsPerCityQuery",
                    "filterTarget": "archivalDescription",
                    "resultMapper": "mapPieChart",
                    "sliceVisibilityThreshold": 0.01,
                    "dropdownForChartTypes": true,
                    "chartTypes": [
                        {
                            "id": "pie",
                            "createChartData": "createApexPieChartData"
                        },
                        {
                            "id": "bar",
                            "createChartData": "createApexBarChartData"
                        }
                    ]
                }
            }
        },
        "descriptionsHolders": {
            "tabID": 2,
            "component": "LeafletMap",
            "tabPath": "descriptions_holders",
            "tabIcon": "AddLocation",
            "sparqlQuery": "descriptionsLocationsQuery",
            "facetClass": "archivalDescriptions",
            "filterTarget": "description",
            "resultMapper": "mapPlaces",
            "showExternalLayers": true,
            "instanceConfig": {
                "propertiesQueryBlock": "descriptionsPropertiesInfoWindow",
                "createPopUpContent": "createPopUpContentMMM"
            }
        }
    },
    "maps": {
        "descriptionsHolders": {
            "center": [
                22.43,
                10.37
            ],
            "zoom": 2
        }
    },
